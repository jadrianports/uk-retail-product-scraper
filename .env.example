# Copy this file to .env. Both settings are optional.

# The contact address for the User-Agent header. The retailer can reach you
# here. With no value the header reads "not supplied" and the run still works.
SCRAPER_CONTACT=

# One model key, for flavour_style and for ABV when the page does not state it.
# The tool reads these in order and uses the first one it finds. With no key
# the derived fields stay null and the run still succeeds.
# A free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
